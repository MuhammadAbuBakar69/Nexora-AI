# Supabase — required. Copy to .env.local and fill in from
# Project Settings -> API Keys. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS for payment webhooks, admin provisioning, and gateway metering.
# Must NEVER be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Payment Gateways (Pakistan PKR / SadaPay Mastercard / Raast)
# Safepay: https://www.getsafepay.com (Sandbox or Production Developer Keys)
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# PayFast (GoPayFast): https://gopayfast.com
PAYFAST_ENV=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=

# SadaPay / Raast Direct Bank Transfer Display Details (optional)
NEXT_PUBLIC_SADAPAY_ACCOUNT_TITLE=Nexora Cloud AI Infrastructure
NEXT_PUBLIC_SADAPAY_ACCOUNT_NUMBER=
NEXT_PUBLIC_SADAPAY_IBAN=

# AI Provider Keys (Server-only, powers /api/v1/chat/completions)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: set only when deploying under a subpath (e.g. /Nexora-AI).
# Leave empty for a root-domain deployment.
# NEXT_PUBLIC_BASE_PATH=
